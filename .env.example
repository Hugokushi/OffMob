# =============================================================
# ARQUIVO: .env.example
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no git!
# =============================================================

# -------------------------------------------------------
# BANCO DE DADOS (Supabase PostgreSQL)
# Obtenha em: supabase.com → seu projeto → Settings → Database
# -------------------------------------------------------
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# -------------------------------------------------------
# AUTENTICAÇÃO (NextAuth / Auth.js)
# Gere o secret com: openssl rand -base64 32
# Em produção no Vercel, NEXTAUTH_URL = sua URL do Vercel
# -------------------------------------------------------
NEXTAUTH_SECRET="gere-uma-string-secreta-aleatoria-aqui"
AUTH_SECRET="gere-uma-string-secreta-aleatoria-aqui"
NEXTAUTH_URL="http://localhost:3000"

# -------------------------------------------------------
# URL PÚBLICA DA APLICAÇÃO
# Em produção: https://seu-projeto.vercel.app
# -------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
